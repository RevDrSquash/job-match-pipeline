# Queue implementation: local | cloudtasks
QUEUE_IMPL=local

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobmatch

# Local TaskQueue posts here (same process / container)
LOCAL_QUEUE_BASE_URL=http://localhost:8080
# extract/generate/verify need more than the old 30s HTTP timeout
# LOCAL_QUEUE_TIMEOUT_SECONDS=180
# LOCAL_QUEUE_MAX_CONCURRENT=4

# PoC/test only: in-memory receipt log + GET /_debug/received (keep false in prod)
ENABLE_DEBUG_CAPTURE=false

# Cloud Tasks (only when QUEUE_IMPL=cloudtasks)
GCP_PROJECT=
GCP_LOCATION=us-central1
CLOUD_TASKS_HANDLER_BASE_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# extract-job (Gemini; postings are not personal information)
# LLM_API_KEY=          # or GEMINI_API_KEY
# EXTRACTION_MODEL=gemini-3.5-flash-lite
# For retrieval-quality evals set EMBEDDING_PROVIDER=gemini (needs the key);
# hashing is an offline stand-in, not for matching quality.
# EMBEDDING_PROVIDER=hashing   # hashing | gemini
# EMBEDDING_MODEL=gemini-embedding-001
# Skill-span similarity (unset = per-provider default; hashing 0.72/0.72/0,
# gemini 0.90/0.85/0.05 — calibrated, see scripts/calibrate_link_threshold.py)
# SKILL_LINK_HIGH_CONFIDENCE=
# SKILL_LINK_THRESHOLD=
# SKILL_LINK_MARGIN=

# Profile ingest CLI (resume text IS personal information — never logged).
# Same LLM_API_KEY/GEMINI_API_KEY as above; job and profile documents must
# share EMBEDDING_PROVIDER or their vector spaces are not comparable.
# PROFILE_PARSER=gemini        # gemini | fallback (offline structured parser)
# PROFILE_PARSE_MODEL=gemini-3.5-flash-lite

# match-batch (jobmatch match run --mode incremental|dirty)
# DAILY_CANDIDATE_CAP=500
# MATCH_TOP_N=100
# DIRTY_PROFILE_CAP=25
# RERANK_PROVIDER=local        # local (cosine) | hosted (Cohere-compatible API)
# RERANK_API_URL=
# RERANK_API_KEY=
# RERANK_MODEL=

# screen-job cheap LLM screen (condensed profile IS personal information — never logged).
# GATE_MODEL=gemini-3.5-flash-lite
# RERANK_HIGH_SCORE_THRESHOLD=0.7
# RERANK_LOW_SCORE_THRESHOLD=0.3
# SCREEN_SCORE_FLOOR=   # unset: screen every match that survived MATCH_TOP_N

# analyze-match qualification report (profile-derived — never logged).
# Daily USD cap is on this stage only; jobmatch analyze run spends it best-first.
# ANALYSIS_MODEL=gemini-3.5-flash
# ANALYSIS_INPUT_USD_PER_MTOK=1.50
# ANALYSIS_OUTPUT_USD_PER_MTOK=9.00
# ANALYSIS_DAILY_BUDGET_USD=0.50
# ANALYSIS_EST_COST_USD=0.01

# generate-resume (resume text IS personal information — never logged).
# GENERATION_MODEL=gemini-3.1-pro-preview
# Same LLM_API_KEY / GEMINI_API_KEY as extract-job.

# verify-resume stages 2–3 must be a different family than the generator.
# VERIFY_API_KEY=                    # or ANTHROPIC_API_KEY
# VERIFY_API_BASE=https://api.anthropic.com
# VERIFY_MODEL=claude-sonnet-4-5
