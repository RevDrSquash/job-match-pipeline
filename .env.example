# Queue implementation: local | cloudtasks
QUEUE_IMPL=local

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jobmatch

# Local TaskQueue posts here (same process / container)
LOCAL_QUEUE_BASE_URL=http://localhost:8080

# PoC/test only: in-memory receipt log + GET /_debug/received (keep false in prod)
ENABLE_DEBUG_CAPTURE=false

# Cloud Tasks (only when QUEUE_IMPL=cloudtasks)
GCP_PROJECT=
GCP_LOCATION=us-central1
CLOUD_TASKS_HANDLER_BASE_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=

# extract-job (Gemini; postings are not personal information)
# LLM_API_KEY=          # or GEMINI_API_KEY
# EXTRACTION_MODEL=gemini-3.5-flash-lite
# For retrieval-quality evals set EMBEDDING_PROVIDER=gemini (needs the key);
# hashing is an offline stand-in, not for matching quality.
# EMBEDDING_PROVIDER=hashing   # hashing | gemini
# EMBEDDING_MODEL=gemini-embedding-001

# Profile ingest CLI (resume text IS personal information — never logged).
# Same LLM_API_KEY/GEMINI_API_KEY as above; job and profile documents must
# share EMBEDDING_PROVIDER or their vector spaces are not comparable.
# PROFILE_PARSER=gemini        # gemini | fallback (offline structured parser)
# PROFILE_PARSE_MODEL=gemini-3.5-flash-lite

# match-batch (jobmatch match run --mode incremental|dirty)
# DAILY_CANDIDATE_CAP=500
# MATCH_TOP_N=100
# DIRTY_PROFILE_CAP=25
# RERANK_PROVIDER=local        # local (cosine) | hosted (Cohere-compatible API)
# RERANK_API_URL=
# RERANK_API_KEY=
# RERANK_MODEL=
