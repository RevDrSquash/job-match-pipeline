# Queue implementation: local | cloudtasks
QUEUE_IMPL=local

# Postgres (docker-compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobmatch

# Local TaskQueue posts here (same process / container)
LOCAL_QUEUE_BASE_URL=http://localhost:8080

# Cloud Tasks (only when QUEUE_IMPL=cloudtasks)
GCP_PROJECT=
GCP_LOCATION=us-central1
CLOUD_TASKS_HANDLER_BASE_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
